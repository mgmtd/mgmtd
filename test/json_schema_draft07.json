{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://example.com/mgmtd-draft07-test",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "mode": {
            "description": "Single allowed value via const",
            "const": "active"
        },
        "count": {
            "description": "Integer with draft-07 exclusive minimum",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 10
        },
        "level": {
            "description": "Integer with inclusive min and exclusive max",
            "type": "integer",
            "minimum": 1,
            "exclusiveMaximum": 5
        },
        "tags": {
            "description": "Leaf-list of strings",
            "type": "array",
            "items": {
                "type": "string"
            },
            "minItems": 1,
            "maxItems": 4
        }
    }
}
