{
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
            "app": {
                "type": "object",
                "properties": {
                    "title": {"type": "string"},
                    "enabled": {"type": "boolean"},
                    "listeners": {
                        "type": "array",
                        "keys": ["name"],
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {"type": "string"},
                                "port": {"type": "integer"}
                            }
                        }
                    }
                }
            }
        }
    }