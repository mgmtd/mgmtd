{application, mgmtd,
 [{description, "A schema driven configuration and operational data management system"},
  {vsn, "0.1.0"},
  {registered, []},
  {mod, {mgmtd_app, []}},
  {applications,
   [kernel,
    stdlib,
    xmerl,
    jsx,
    cowboy,
    erlydtl
   ]},
  {env, [{restconf, [{enabled, false}, {port, 8008}]},
         {rollback, [{count, 10}]},
         {startup, []},
         {aaa, [{default_role, admin}, {users, []}]}]},
  {modules, []},

  {licenses, ["Apache 2.0"]},
  {links, []}
 ]}.
