{minimum_otp_vsn, "24.0"}.
{erl_opts, [debug_info]}.
{deps, [
  {jsx, {git, "https://github.com/talentdeficit/jsx.git", {tag, "v3.1.0"}}},
  %% Last Cowboy/Cowlib/Ranch that still CI-test OTP 24. Cowboy 2.19,
  %% Cowlib 2.20 and Ranch 2.3 require OTP 27+. Fetch via git so Hex's
  %% OTP 27+ beams are not used; Cowboy 2.18's own rebar.config still
  %% asks for Ranch 1.8.1, so pin Ranch 2.2.1 here and in overrides.
  {cowboy, {git, "https://github.com/ninenines/cowboy.git", {tag, "2.18.0"}}},
  {ranch, {git, "https://github.com/ninenines/ranch.git", {tag, "2.2.1"}}},
  {cowlib, {git, "https://github.com/ninenines/cowlib.git", {tag, "2.19.0"}}},
  {erlydtl, {git, "https://github.com/erlydtl/erlydtl.git", {tag, "0.15.0"}}},
  {eqwalizer_support,
    {git_subdir,
        "https://github.com/whatsapp/erlang-language-platform.git",
        {branch, "main"},
        "eqwalizer/eqwalizer_support"}}
]}.

{plugins, [
  {rebar3_erlydtl_plugin, "0.1.1"}
]}.

%% Analysis-only; not in {plugins, ...} so geas does not include itself.
{project_plugins, [geas_rebar3]}.

{provider_hooks, [
  {pre, [{compile, {erlydtl, compile}}]}
]}.

{erlydtl_opts, [
  {doc_root, "priv/templates"},
  {source_ext, ".dtl"},
  {module_ext, "_dtl"},
  {auto_escape, true},
  {compiler_options, [debug_info]}
]}.

{shell, [
  % {config, "config/sys.config"},
    {apps, [mgmtd]}
]}.
